# Copy to .env and fill in. Never commit .env.

# Required for live runs (not needed for `--demo` or the tests).
ANTHROPIC_API_KEY=

# Models (defaults shown).
WC_SUPERVISOR_MODEL=claude-opus-5-5
WC_SUBAGENT_MODEL=claude-sonnet-5-5

# Per-subagent guardrails.
WC_SUBAGENT_MAX_TURNS=12
WC_SUBAGENT_BUDGET_USD=0.75
WC_SUBAGENT_TIMEOUT_S=300

# Optional: TfL app key for higher Journey Planner rate limits (works without one).
TFL_APP_KEY=

# Optional path overrides (mostly for tests).
# WC_PREFERENCES_PATH=config/preferences.yaml
# WC_OUTPUTS_DIR=outputs
# WC_TRACE_PATH=logs/agent_trace.jsonl
